VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_GRAPH_VERSION=v26.0

# Somente backend / Supabase secrets, nunca prefixar com VITE_
# META_VERIFY_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v26.0
# AI_PROVIDER=mock
# OPENAI_API_KEY=

# IA server-side (Supabase Edge Functions). Nunca use VITE_ para estes segredos.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=12000
# Opcional: custo estimado por 1 milhão de tokens para telemetria/limites.
AI_INPUT_COST_PER_1M=0
AI_OUTPUT_COST_PER_1M=0

# Gateway temporário hospedado (Railway) para o piloto WhatsApp Web 24h
VITE_PILOT_GATEWAY_URL=
